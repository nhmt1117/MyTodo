{
  "name": "mytodo",
  "version": "2.0.6",
  "description": "MyTodo 个人待办与循环提醒工具",
  "main": "main.js",
  "author": "nhmt",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/check-electron.js",
    "check:electron": "node scripts/check-electron.js",
    "verify:release": "node scripts/verify-release.js",
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "test": "node --test",
    "check": "node --check main.js && node --check preload.js && node --check src/main/backup.js && node --check src/main/config.js && node --check src/main/dataLocation.js && node --check src/main/installOptions.js && node --check src/main/logger.js && node --check src/main/storage.js && node --check src/main/supportTools.js && node --check src/main/todoStore.js && node --check src/main/reminderScheduler.js && node --check src/main/updateManager.js && node --check src/main/windows.js && node --check src/main/ipc.js && node --check src/shared/recurrence.js && node --check renderer/renderer.js && node --check renderer/float.js && node --check renderer/reminder.js && npm test"
  },
  "build": {
    "appId": "com.nhmt.mytodo",
    "productName": "MyTodo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "float.html",
      "reminder.html",
      "assets/**/*",
      "renderer/**/*",
      "src/**/*",
      "wordlist.json",
      "README.md",
      "CHANGELOG.md",
      "V1_RELEASE_CHECKLIST.md",
      "V1_RELEASE_TEST_REPORT.md",
      "V2_RELEASE_CHECKLIST.md",
      "V2_RELEASE_TEST_REPORT.md",
      "LICENSE",
      "!node_modules/.cache",
      "!dist"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "MyTodo.ico",
        "to": "MyTodo.ico"
      },
      {
        "from": "MyTodo.ico",
        "to": "MyTodoTaskbar.ico"
      }
    ],
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "nsis",
      "icon": "MyTodo.ico"
    },
    "nsis": {
      "oneClick": false,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyTodo",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/nhmt1117/MyTodo/releases/latest/download"
    }
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "3.4.0"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
